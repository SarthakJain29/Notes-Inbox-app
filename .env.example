# --- Required for the real Telegram bot (not needed for `npm run simulate`) ---
TELEGRAM_BOT_TOKEN=
# Only this Telegram user ID gets responses. Message @userinfobot to find yours.
ALLOWED_TELEGRAM_USER_ID=

# --- LLM providers (free tiers). All optional: with no keys the app runs in mock mode. ---
GEMINI_API_KEY=
GROQ_API_KEY=
# auto | gemini | groq | mock   (auto = gemini if key, else groq if key, else mock)
LLM_PROVIDER=auto
# Model ids can be a comma-separated fallback list (tried in order)
# GEMINI_MODEL=gemini-flash-lite-latest,gemini-flash-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- App ---
# IANA timezone used for due dates and the morning digest
TIMEZONE=UTC
# Hour (0-23, in TIMEZONE) when the morning digest is sent
DIGEST_HOUR=8
DATABASE_PATH=./data/notes.db

# --- Hosting: polling (default, no public URL) or webhook ---
BOT_MODE=polling
# Webhook mode only: public https base URL of your deployment, and a random secret
WEBHOOK_URL=
WEBHOOK_SECRET=
# HTTP port (health check + webhook). Render/Railway/Fly set PORT for you.
PORT=3000
